PORT=3333
# Render: use the Internal Database URL. From outside Render (seed), the External URL + ?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/buildflow
JWT_SECRET=change-me
JWT_EXPIRES_IN=12h
# Comma separated list of allowed front-end origins ("*" allows any)
CORS_ORIGIN=http://localhost:3000
# Local time zone used to group sales by day (dashboard, reports, cash flow)
TZ=America/Maceio
# Enables POST /data/reset (restore demo data). Keep false in production.
ALLOW_DATA_RESET=true
