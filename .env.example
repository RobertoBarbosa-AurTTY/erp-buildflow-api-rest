PORT=3333
MONGODB_URI=mongodb://localhost:27017/buildflow
JWT_SECRET=change-me
JWT_EXPIRES_IN=12h
# Comma separated list of allowed front-end origins ("*" allows any)
CORS_ORIGIN=http://localhost:3000
# Local time zone used to group sales by day (dashboard, reports, cash flow)
TZ=America/Maceio
# Enables POST /data/reset (restore demo data). Keep false in production.
ALLOW_DATA_RESET=true
